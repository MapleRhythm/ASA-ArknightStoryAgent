{
  "retrieval": {
    "device": "cuda",
    "enable_reranker": true,
    "reranker_model_path": "model/reranker/bge-reranker-v2-m3-evidence-chain-answerability",
    "dense_top_k": 120,
    "sparse_top_k": 120,
    "enable_minirag": true,
    "minirag_index_path": "indexes/arknights_story_minirag/graph.json",
    "minirag_weight": 0.35,
    "minirag_mode_weights": {
      "fact": 0.5,
      "relation": 1.0,
      "causality": 1.0,
      "reveal": 1.0,
      "reasoning": 0.75,
      "mystery": 0.75,
      "answerability": 0.75
    },
    "fusion_top_k": 80,
    "rerank_top_k": 32,
    "rerank_batch_size": 8,
    "reranker_max_length": 1024,
    "enable_neighbor_expansion": false,
    "neighbor_max_seed_docs": 24,
    "neighbor_story_window": 2,
    "neighbor_activity_story_sort_window": 1
  },
  "generator": {
    "backend": "vllm",
    "ctx_size": 8192,
    "max_tokens": 512,
    "temperature": 0.2,
    "top_p": 0.9,
    "repeat_penalty": 1.05,
    "vllm": {
      "base_model_path": "model/qwen3.5-4b",
      "lora_path": "model/lora/asa-arknightstoryagent-4b-lora",
      "tensor_parallel_size": 1,
      "gpu_memory_utilization": 0.62,
      "max_model_len": 8192,
      "dtype": "auto"
    }
  },
  "inference": {
    "max_retrieval_rounds": 3,
    "prompt_evidence_top_k": 12,
    "enable_mmr": true,
    "mmr_lambda": 0.72,
    "enable_pyramid_order": true,
    "enable_crag_refinement": true,
    "crag_refine_top_sentences": 4,
    "crag_refine_max_sentences": 24,
    "self_consistency_samples": 3,
    "self_consistency_temperature": 0.7,
    "use_model_hypothesis": true,
    "use_model_conclusion_generation": true
  }
}
