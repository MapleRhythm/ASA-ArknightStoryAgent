{
  "retrieval": {
    "device": "cpu",
    "enable_reranker": false,
    "dense_top_k": 80,
    "sparse_top_k": 80,
    "enable_minirag": true,
    "minirag_index_path": "indexes/arknights_story_minirag/graph.json",
    "fusion_top_k": 50,
    "rerank_top_k": 20,
    "rerank_batch_size": 4,
    "enable_neighbor_expansion": false,
    "neighbor_max_seed_docs": 24,
    "neighbor_story_window": 2,
    "neighbor_activity_story_sort_window": 1
  },
  "generator": {
    "backend": "openai_compatible_api",
    "api_base_url": "https://api.openai.com/v1/chat/completions",
    "api_key_env": "OPENAI_API_KEY",
    "model": "gpt-4.1-mini",
    "timeout": 120,
    "max_tokens": 4096,
    "temperature": 0.1,
    "top_p": 0.9,
    "response_format_json": true,
    "extra_body": {}
  },
  "inference": {
    "max_retrieval_rounds": 3,
    "prompt_evidence_top_k": 10,
    "enable_mmr": true,
    "mmr_lambda": 0.72,
    "enable_pyramid_order": true,
    "enable_crag_refinement": true,
    "crag_refine_top_sentences": 4,
    "crag_refine_max_sentences": 24,
    "self_consistency_samples": 1,
    "self_consistency_temperature": 0.7,
    "use_model_hypothesis": true,
    "use_model_conclusion_generation": true
  }
}
