{
  "retrieval": {
    "device": "cuda",
    "enable_reranker": true,
    "reranker_model_path": "model/reranker/bge-reranker-v2-m3-rank-mix-v6-small-patch",
    "dense_top_k": 120,
    "sparse_top_k": 120,
    "enable_minirag": true,
    "minirag_index_path": "indexes/arknights_story_minirag_v3/graph.json",
    "minirag_weight": 0.35,
    "minirag_mode_weights": {
      "fact": 0.5,
      "relation": 1.0,
      "causality": 1.0,
      "reveal": 1.0,
      "reasoning": 0.75,
      "mystery": 0.75,
      "answerability": 0.75
    },
    "fusion_top_k": 120,
    "rerank_top_k": 40,
    "rerank_batch_size": 16,
    "reranker_max_length": 1024,
    "reranker_candidate_top_k": 180,
    "enable_neighbor_expansion": true,
    "neighbor_max_seed_docs": 32,
    "neighbor_story_window": 3,
    "neighbor_activity_story_sort_window": 1
  },
  "generator": {
    "backend": "chat_completions",
    "api_base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model": "deepseek-v4-flash",
    "timeout": 120,
    "max_tokens": null,
    "temperature": 0.1,
    "top_p": 0.9,
    "response_format_json": true
  },
  "inference": {
    "pipeline_mode": "standard",
    "initial_prompt_hint": "直接回答用户问题。提示词越少越好；可以使用你已有的剧情知识，但不确定的细节不要写死。",
    "initial_answer_max_tokens": null,
    "refine_answer_max_tokens": null,
    "max_retrieval_rounds": 2,
    "prompt_evidence_top_k": 8,
    "prompt_evidence_max_chars_per_doc": 1000,
    "prompt_conclusion_evidence_max_total_chars": 7000,
    "enable_mmr": true,
    "mmr_lambda": 0.76,
    "enable_pyramid_order": false,
    "enable_evidence_pinning": true,
    "enable_crag_refinement": true,
    "crag_refine_top_sentences": 5,
    "crag_refine_max_sentences": 28,
    "self_consistency_samples": 1,
    "self_consistency_temperature": 0.7,
    "answer_grounding_mode": "weak",
    "use_model_hypothesis": true,
    "use_model_conclusion_generation": true
  }
}
