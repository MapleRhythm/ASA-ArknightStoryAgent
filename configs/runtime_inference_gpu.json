{
  "retrieval": {
    "device": "cuda",
    "enable_reranker": true,
    "reranker_model_path": "model/reranker/bge-reranker-v2-m3-rank-mix-v6-small-patch",
    "dense_top_k": 120,
    "sparse_top_k": 120,
    "enable_minirag": true,
    "minirag_index_path": "indexes/arknights_story_minirag_v3/graph.json",
    "minirag_weight": 0.35,
    "minirag_mode_weights": {
      "fact": 0.5,
      "relation": 1.0,
      "causality": 1.0,
      "reveal": 1.0,
      "reasoning": 0.75,
      "mystery": 0.75,
      "answerability": 0.75
    },
    "fusion_top_k": 80,
    "rerank_top_k": 32,
    "rerank_batch_size": 4,
    "reranker_max_length": 1024,
    "minirag_chapter_isolation": true,
    "minirag_auto_second_retrieval": true,
    "minirag_scope_seed_top_k": 40,
    "minirag_expansion_query_top_k": 8,
    "minirag_graph_scope_min_ratio": 1.0,
    "minirag_second_pass_scope_min_ratio": 1.0,
    "enable_storyline_sparse_scope": true,
    "storyline_scope_seed_top_k": 40,
    "storyline_sparse_scope_min_ratio": 1.5,
    "enable_neighbor_expansion": true,
    "neighbor_max_seed_docs": 16,
    "neighbor_story_window": 2,
    "neighbor_activity_story_sort_window": 1
  },
  "generator": {
    "backend": "vllm",
    "ctx_size": 12000,
    "max_tokens": 512,
    "temperature": 0.2,
    "top_p": 0.9,
    "repeat_penalty": 1.05,
    "llama_cpp": {
      "device": "cuda",
      "gpu_layers": "all",
      "batch_size": 2048,
      "ubatch_size": 512,
      "flash_attn": "auto"
    },
    "vllm": {
      "base_model_path": "model/qwen3.5-4b",
      "lora_path": "model/lora/teacher_online_chain_short_prompt_v2_ds_flash_500_plus_smoke20_sample50_quality_fix3_plus_detail_conclusion_patch_v1_qwen35_4b_lr2e5_epoch1",
      "tensor_parallel_size": 1,
      "gpu_memory_utilization": 0.62,
      "max_model_len": 12000,
      "dtype": "auto"
    }
  },
  "inference": {
    "max_retrieval_rounds": 2,
    "prompt_evidence_top_k": 12,
    "prompt_evidence_max_chars_per_doc": 1800,
    "prompt_conclusion_evidence_max_total_chars": 24000,
    "enable_mmr": false,
    "mmr_lambda": 0.72,
    "enable_pyramid_order": false,
    "enable_evidence_pinning": false,
    "enable_crag_refinement": false,
    "crag_refine_top_sentences": 4,
    "crag_refine_max_sentences": 24,
    "self_consistency_samples": 1,
    "self_consistency_temperature": 0.7,
    "conclusion_prompt_mode": "minimal",
    "answer_grounding_mode": "weak",
    "use_model_hypothesis": true,
    "use_model_conclusion_generation": true,
    "web_context": {
      "enabled": true,
      "cache_dir": "outputs/web_context_cache",
      "cache_ttl_seconds": 604800,
      "timeout_seconds": 4,
      "max_elapsed_seconds": 12,
      "max_first_round_evidence": 24,
      "min_story_hits": 2,
      "max_search_queries": 3,
      "max_search_results": 4,
      "max_pages": 2,
      "max_chars_per_page": 2200,
      "max_total_chars": 6000,
      "rerank_top_k": 2,
      "rerank_min_score": 1.0,
      "require_story_or_question_hit": true,
      "force_prompt_evidence": false,
      "search_url_templates": [
        "https://www.sogou.com/web?query={query}",
        "http://www.baidu.com/s?wd={query}"
      ],
      "query_templates": [
        "明日方舟 {story_name} {question_terms} 剧情解析 时间线",
        "明日方舟 {story_name} 剧情解析 时间线",
        "{story_name} {question_terms} 明日方舟 剧情",
        "{story_name} 明日方舟 剧情解析"
      ]
    }
  }
}
